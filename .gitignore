node_modules/
dist/
*.local
.DS_Store

# Self-signed TLS material generated by the container on first start.
certs/

# Compiled TS output. Vite transpiles .ts directly and tsc runs with noEmit,
# so no .js should live in src/ — but ignore any stray emit to be safe. (Vite
# resolves .js before .ts, so a stale committed .js would silently shadow its
# source in dev — never track these.)
/src/*.js
/src/**/*.js

# Rig dumps from tools/rigdump.mjs — local diagnostic output, model-specific.
rig.json
*.rig.json
